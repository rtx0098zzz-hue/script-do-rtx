local Utils = {}

function Utils.create(className, props)
    local inst = Instance.new(className)
    for k, v in pairs(props) do
        if k ~= "Parent" then inst[k] = v end
    end
    if props.Parent then inst.Parent = props.Parent end
    return inst
end

function Utils.tween(inst, dur, goal)
    local t = TweenService:Create(
        inst,
        TweenInfo.new(dur or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        goal
    )
    t:Play()
    return t
end

function Utils.corner(parent, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = parent
    return c
end

function Utils.stroke(parent, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or Config.UI.Border
    s.Thickness = thickness or 1
    s.Transparency = transparency or 0.3
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = parent
    return s
end

function Utils.padding(parent, px)
    local p = Instance.new("UIPadding")
    p.PaddingTop = UDim.new(0, px)
    p.PaddingBottom = UDim.new(0, px)
    p.PaddingLeft = UDim.new(0, px)
    p.PaddingRight = UDim.new(0, px)
    p.Parent = parent
    return p
end

function Utils.distance(a, b)
    if typeof(a) == "Instance" then a = a.Position end
    if typeof(b) == "Instance" then b = b.Position end
    return (a - b).Magnitude
end

function Utils.getHumanoid(model)
    if not model or not model:IsA("Model") then return nil end
    return model:FindFirstChildOfClass("Humanoid")
end

function Utils.getRoot(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart")
end

function Utils.isAlive(model)
    local hum = Utils.getHumanoid(model)
    return hum and hum.Health > 0
end

