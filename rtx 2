-- BUSCA DE NPCs
-- ═══════════════════════════════════════════════
local NpcFinder = {}

function NpcFinder.scanContainer(container, originPos, radius, results)
    for _, obj in ipairs(container:GetDescendants()) do
        if not obj:IsA("Model") then continue end
        if obj == LocalPlayer.Character then continue end
        if Players:GetPlayerFromCharacter(obj) then continue end

        local hum = Utils.getHumanoid(obj)
        local root = Utils.getRoot(obj)
        if not hum or not root or hum.Health <= 0 then continue end

        -- Filtro por atributo
        if Config.Farm.NpcAttribute and obj:GetAttribute(Config.Farm.NpcAttribute) == false then
            continue
        end

        -- Filtro por nome
        local name = obj.Name
        local blocked = false
        for _, b in ipairs(Config.Farm.Blacklist) do
            if name:lower():find(b:lower(), 1, true) then blocked = true break end
        end
        if blocked then continue end

        if #Config.Farm.Whitelist > 0 then
            local ok = false
            for _, w in ipairs(Config.Farm.Whitelist) do
                if name:lower():find(w:lower(), 1, true) then ok = true break end
            end
            if not ok then continue end
        end

        if Config.Farm.NpcNameContains then
            if not name:lower():find(Config.Farm.NpcNameContains:lower(), 1, true) then
                continue
            end
        end

        local d = Utils.distance(originPos, root.Position)
        if d <= radius then
            table.insert(results, { model = obj, distance = d })
        end
    end
end

function NpcFinder.findNearest(originPos, radius)
    local results = {}
    if Config.Farm.NpcFolderName then
        local folder = workspace:FindFirstChild(Config.Farm.NpcFolderName, true)
        if folder then
            NpcFinder.scanContainer(folder, originPos, radius, results)
        end
    else
        NpcFinder.scanContainer(workspace, originPos, radius, results)
    end
    table.sort(results, function(a, b) return a.distance < b.distance end)
    return results[1] and results[1].model or nil
end

-- ═══════════════════════════════════════════════
-- MOVIMENTO (usa Humanoid:MoveTo — mecânica natural)
-- ═══════════════════════════════════════════════
local Movement = {}

function Movement.moveTo(position)
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = Utils.getHumanoid(char)
    if not hum or hum.Health <= 0 then return false end

    -- Tenta pathfinding para desviar de obstáculos
    local ok, path = pcall(function()
        local p = PathfindingService:CreatePath({
            AgentRadius = 2,
            AgentHeight = 5,
            AgentCanJump = true,
        })
        p:ComputeAsync(char.HumanoidRootPart.Position, position)
        return p
    end)

    if ok and path and path.Status == Enum.PathStatus.Success then
        for _, wp in ipairs(path:GetWaypoints()) do
            if not State.FarmActive and not State.RaidActive then return false end
            if wp.Action == Enum.PathWaypointAction.Jump then
                hum.Jump = true
            end
            hum:MoveTo(wp.Position)
            local reached = hum.MoveToFinished:Wait()
            if not reached then break end
        end
    else
        hum:MoveTo(position)
    end
    return true
end

-- ═══════════════════════════════════════════════
-- ATAQUE (usa ferramenta equipada — mecânica natural)
-- ═══════════════════════════════════════════════
local Combat = {}

function Combat.attack(target)
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function() tool:Activate() end)
    else
        -- Fallback: eventos padrão de clique
        local mouse = LocalPlayer:GetMouse()
        if mouse and target then
            local targetPart = Utils.getRoot(target)
            if targetPart then
                mouse.Hit = targetPart.CFrame
            end
        end
    end
end

function Combat.faceTarget(target)
    local char = LocalPlayer.Character
    if not char then return end
    local root = Utils.getRoot(char)
    local tRoot = Utils.getRoot(target)
    if root and tRoot then
        local dir = (tRoot.Position - root.Position)
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude > 0.1 then
            root.CFrame = CFrame.new(root.Position, root.Position + dir)
        end
    end
end

-- ═══════════════════════════════════════════════
-- SISTEMA DE FARM
-- ═══════════════════════════════════════════════
local FarmSystem = {}
FarmSystem.__index = FarmSystem

function FarmSystem.new(bus)
    local self = setmetatable({}, FarmSystem)
    self.bus = bus
    self.currentTarget = nil
    self.thread = nil
    self.iterations = 0
    return self
end

function FarmSystem:getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = Utils.getHumanoid(char)
    if not hum or hum.Health <= 0 then return nil end
    return char, hum
end

function FarmSystem:airFarmTick()
    if not State.AirFarmActive then return end
    local char, hum = self:getCharacter()
    if not char then return end
    local root = Utils.getRoot(char)
    if not root then return end

    -- Mantém altura usando salto (mecânica padrão)
    local ray = Ray.new(root.Position, Vector3.new(0, -(Config.AirFarm.Height + 8), 0))
    local hit, pos = workspace:FindPartOnRay(ray, char)
    if hit and (root.Position.Y - pos.Y) < Config.AirFarm.Height then
        hum.Jump = true
    end
end

function FarmSystem:loop()
    while State.FarmActive and self.iterations < Config.Farm.MaxIterations do
        self.iterations += 1

        local char, hum = self:getCharacter()
        if not char then
            self.bus:setStatus("Personagem morto — aguardando", Config.UI.Warning)
            task.wait(1)
            continue
        end

        local root = Utils.getRoot(char)

        -- Se alvo morreu ou não existe, procura novo
        if not Utils.isAlive(self.currentTarget) then
            self.currentTarget = nil
            State.CurrentTarget = "—"
            self.bus:setStatus("Farmando — buscando NPC", Config.UI.Primary)
            self.bus:setTarget("—")

            self.currentTarget = NpcFinder.findNearest(root.Position, Config.Farm.RadiusSearch)

            if not self.currentTarget then
                self.bus:setStatus("Farmando — nenhum NPC próximo", Config.UI.Warning)
                task.wait(1)
                continue
            end

            State.CurrentTarget = self.currentTarget.Name
            self.bus:setTarget(self.currentTarget.Name)
        end

        if not self.currentTarget then
            task.wait(0.5)
            continue
        end

        local tRoot = Utils.getRoot(self.currentTarget)
        if not tRoot then
            self.currentTarget = nil
            continue
        end

        local dist = Utils.distance(root.Position, tRoot.Position)

        if dist > Config.Farm.AttackRange then
            self.bus:setStatus("Farmando — indo até " .. self.currentTarget.Name, Config.UI.Primary)
            if not Movement.moveTo(tRoot.Position) then
                task.wait(0.1)
            end
        else
            self.bus:setStatus("Derrotando NPC", Config.UI.Danger)
            Combat.faceTarget(self.currentTarget)
            Combat.attack(self.currentTarget)
            if State.AirFarmActive then self:airFarmTick() end
        end

        task.wait(Config.Farm.AttackCooldown)
    end

    -- Final do loop
    if self.iterations >= Config.Farm.MaxIterations then
        self.bus:setStatus("Farm — limite de segurança atingido", Config.UI.Warning)
        State.FarmActive = false
    end
end

function FarmSystem:start()
    if State.FarmActive then return end
    State.FarmActive = true
    self.iterations = 0
    self.bus:setStatus("Farmando", Config.UI.Success)
    self.thread = task.spawn(function() self:loop() end)
end

function FarmSystem:stop()
    State.FarmActive = false
    self.currentTarget = nil
    State.CurrentTarget = "—"
    self.bus:setTarget("—")
    self.bus:setStatus("Aguardando", Config.UI.TextMuted)
end

-- ═══════════════════════════════════════════════
-- SISTEMA DE RAID
-- ═══════════════════════════════════════════════
local RaidSystem = {}
RaidSystem.__index = RaidSystem

function RaidSystem.new(bus)
    local self = setmetatable({}, RaidSystem)
    self.bus = bus
    self.currentNpc = nil
    self.iterations = 0
    return self
end

function RaidSystem:getCharacter()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = Utils.getHumanoid(char)
    if not hum or hum.Health <= 0 then return nil end
    return char, hum
end

function RaidSystem:getRaidNpcs()
    local list = {}
    local folder = workspace:FindFirstChild(Config.Raid.NpcFolderName, true)
    local container = folder or workspace
    for _, obj in ipairs(container:GetDescendants()) do
        if not obj:IsA("Model") then continue end
        if Players:GetPlayerFromCharacter(obj) then continue end
        if not Utils.isAlive(obj) then continue end
        if not Utils.getRoot(obj) then continue end
        table.insert(list, obj)
    end
    return list
end

function RaidSystem:getNextArea()
    local areasFolder = workspace:FindFirstChild(Config.Raid.AreaFolderName, true)
    if not areasFolder then return nil end
    for _, area in ipairs(areasFolder:GetChildren()) do
        if area:IsA("BasePart") then
            return area.Position
        end
    end
    return nil
end

function RaidSystem:loop()
    State.RaidProgress = 0
    State.RaidTotal = 0
    self.bus:setStatus("Indo para ilha da raid", Config.UI.Warning)

    task.wait(1)

    while State.RaidActive and self.iterations < Config.Farm.MaxIterations do
        self.iterations += 1

        local char, hum = self:getCharacter()
        if not char then
            task.wait(1)
            continue
        end
        local root = Utils.getRoot(char)

        -- Se alvo inválido, busca novo
        if not Utils.isAlive(self.currentNpc) then
            self.currentNpc = nil

            local npcs = self:getRaidNpcs()
            State.RaidTotal = #npcs

            if #npcs == 0 then
                -- Tenta próxima área
                local nextArea = self:getNextArea()
                if nextArea then
                    self.bus:setStatus("Indo para próxima área", Config.UI.Warning)
                    Movement.moveTo(nextArea)
                    task.wait(1)
                    -- Recheca; se continuar vazio após N tentativas, encerra
                    local retry = self:getRaidNpcs()
                    if #retry == 0 then
                        self.bus:setStatus("Raid concluída", Config.UI.Success)
                        self.bus:setProgress(State.RaidProgress, State.RaidProgress)
                        State.RaidActive = false
                        return
                    end
                else
                    self.bus:setStatus("Raid concluída", Config.UI.Success)
                    self.bus:setProgress(State.RaidProgress, State.RaidProgress)
                    State.RaidActive = false
                    return
                end
            else
                -- Ordena por distância
                table.sort(npcs, function(a, b)
                    local ra, rb = Utils.getRoot(a), Utils.getRoot(b)
                    if not ra or not rb then return false end
                    return Utils.distance(root.Position, ra.Position)
                         < Utils.distance(root.Position, rb.Position)
                end)
                self.currentNpc = npcs[1]
                State.CurrentTarget = self.currentNpc.Name
                self.bus:setTarget(self.currentNpc.Name)
            end
        end

        if self.currentNpc then
            local tRoot = Utils.getRoot(self.currentNpc)
            if tRoot then
                local dist = Utils.distance(root.Position, tRoot.Position)
                if dist > Config.Raid.AttackRange then
                    self.bus:setStatus("Raid em andamento — indo até alvo", Config.UI.Primary)
                    Movement.moveTo(tRoot.Position)
                else
                    self.bus:setStatus("Raid em andamento", Config.UI.Danger)
                    Combat.faceTarget(self.currentNpc)
                    Combat.attack(self.currentNpc)

                    -- Detecta morte
                    local hum2 = Utils.getHumanoid(self.currentNpc)
                    if not hum2 or hum2.Health <= 0 then
                        State.RaidProgress += 1
                        self.bus:setProgress(State.RaidProgress, State.RaidTotal)
                        self.currentNpc = nil
                    end
                end
            else
                self.currentNpc = nil
            end
        end

        task.wait(Config.Raid.AttackCooldown)
    end

    if self.iterations >= Config.Farm.MaxIterations then
        self.bus:setStatus("Raid — limite de segurança", Config.UI.Warning)
        State.RaidActive = false
    end
end

function RaidSystem:start(islandName)
    if State.RaidActive then return end
    State.RaidActive = true
    self.iterations = 0
    State.CurrentIsland = islandName or State.CurrentIsland
    self.bus:setIsland(State.CurrentIsland)
    self.bus:setStatus("Raid em andamento", Config.UI.Success)
    task.spawn(function() self:loop() end)
end

function RaidSystem:stop()
    State.RaidActive = false
    self.currentNpc = nil
    State.CurrentTarget = "—"
    self.bus:setTarget("—")
    self.bus:setStatus("Raid parada", Config.UI.TextMuted)
end

